# Local frontend configuration: backend running on this computer.
VITE_API_BASE_URL="http://127.0.0.1:3000/api/v1"

# Set this only for local GitHub Pages-style path testing.
BASE_PATH="/"

# For GitHub Pages Actions, leave VITE_API_BASE_URL unset unless a remotely hosted
# backend is configured. Never set it to localhost: each visitor's localhost is
# their own device, and HTTPS Pages cannot call the local HTTP API.
