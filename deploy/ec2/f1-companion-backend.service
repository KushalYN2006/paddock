[Unit]
Description=F1 Championship Companion API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=f1companion
Group=f1companion
WorkingDirectory=/opt/f1-companion/backend
EnvironmentFile=/etc/f1-companion/backend.env
ExecStart=/usr/bin/node /opt/f1-companion/backend/dist/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/f1-companion

[Install]
WantedBy=multi-user.target
